# Backend
DATABASE_URL=postgresql://realestate:realestate@localhost:5432/realestate
CORS_ORIGINS=http://localhost:3000
DEBUG=false

# AI provider (Phase 4)
AI_PROVIDER=groq
GROQ_API_KEY=
